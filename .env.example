# Copy to .env, edit locally, then run: node --env-file=.env server/index.mjs
# Never commit credentials. Regular npm start reads shell environment only.
APP_MODE=production
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=data/production.sqlite
APP_ORIGIN=https://volunteers.example.internal
TRUST_PROXY=1
# Initial bootstrap only: set a unique 14+ character password with upper/lowercase,
# a number, and a symbol. Remove this variable after the administrator exists.
ADMIN_PASSWORD=
